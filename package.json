{
 "name": "pawcare-vet-clinic-hub",
 "private": true,
 "version": "1.0.0",
 "type": "module",
 "scripts": {
  "dev": "concurrently -n \"API,VITE\" -c \"blue,green\" \"node server/server.js\" \"vite\"",
  "dev:frontend": "vite",
  "server": "node server/server.js",
  "db:init": "node server/scripts/init-neon.js",
  "test:system:postgres": "node --experimental-test-module-mocks --test server/tests/system-p2-postgres.test.js",
  "test:ui": "node --test tests/ui-rendering.test.js",
  "test:dates": "node --test tests/clinic-date.test.js",
  "test:lockout:postgres": "node --experimental-test-module-mocks --test server/tests/login-lockout-postgres.test.js",
  "test:recovery:postgres": "node --experimental-test-module-mocks --test server/tests/password-recovery-postgres.test.js",
  "test:origin": "node --experimental-test-module-mocks --test server/tests/app-origin.test.js",
  "test:account:postgres": "node --experimental-test-module-mocks --test server/tests/contact-changes-postgres.test.js",
  "test:account": "node --experimental-test-module-mocks --test server/tests/account.test.js tests/account-profile.test.js",
  "test:auth": "node --experimental-test-module-mocks --test server/tests/auth-flow.test.js",
  "test:email": "node server/scripts/test-email.js",
  "build": "vite build",
  "preview": "vite preview",
  "test:clinic": "node --experimental-test-module-mocks --test server/tests/clinic-security.test.js server/tests/calendar-state.test.js tests/clinic-client.test.js tests/calendar-doctors.test.js",
  "reminders:worker": "node server/scripts/reminder-worker.js",
  "reminders:once": "node server/scripts/reminder-worker.js --once",
  "test:scheduling": "node --test server/tests/scheduling.test.js server/tests/reminder-delivery.test.js",
  "test:scheduling:postgres": "node --test server/tests/scheduling-postgres.test.js",
  "test:approval:postgres": "node --test server/tests/appointment-approval-postgres.test.js",
  "test:registration:postgres": "node --test server/tests/pet-registration-postgres.test.js",
  "test:admin:postgres": "node --experimental-test-module-mocks --test server/tests/admin-postgres.test.js",
  "test:workflow:postgres": "node --experimental-test-module-mocks --test server/tests/connected-workflow-postgres.test.js",
  "test:admissions:postgres": "node --experimental-test-module-mocks --test server/tests/admissions-postgres.test.js",
  "db:migrate:check": "node server/scripts/migrate.js --check",
  "db:migrate": "node server/scripts/migrate.js --apply"
 },
 "dependencies": {
  "bcryptjs": "^3.0.3",
  "cookie-parser": "^1.4.7",
  "cors": "^2.8.6",
  "country-state-city": "^3.2.1",
  "dotenv": "^18.0.9",
  "express": "^5.3.0",
  "free-email-domains": "^1.15.12",
  "libphonenumber-js": "^1.13.15",
  "lucide-react": "0.469.0",
  "nodemailer": "^10.2.1",
  "pdfkit": "^0.17.2",
  "pg": "^8.23.1",
  "react": "^18.3.1",
  "react-dom": "^18.3.1"
 },
 "devDependencies": {
  "@vitejs/plugin-react": "^4.3.1",
  "concurrently": "^10.0.6",
  "pdfjs-dist": "^5.4.296",
  "vite": "^5.4.8"
 }
}
