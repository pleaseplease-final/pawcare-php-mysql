# ---------------------------------------------------------------------------
# Node.js API (npm run dev) — the system's back end
# ---------------------------------------------------------------------------
# PostgreSQL connection string, e.g. from a free Neon project (neon.tech → Connection string).
# After setting it, create the tables and staff accounts once with: npm run db:init
DATABASE_URL=postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Port for the Node API (the Vite dev server forwards /api here)
PORT=3000
# Public address of the site (required in production; links in emails use it)
APP_URL=http://localhost:5173

# Text-message codes (OTP) and reminders. Without one of these, SMS codes are NOT sent.
# TextBee (https://textbee.dev): install the TextBee app on an Android phone with load, keep it online.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# Alternative: PhilSMS
PHILSMS_TOKEN=

# Email codes and invitations. Brevo (https://brevo.com) or any SMTP account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PawCare Clinic <noreply@pawcare.com>

# Secret the daily reminder job sends (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# ---------------------------------------------------------------------------
# PHP + MySQL back end (only for npm run dev:php)
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pawcare_db
DB_USER=root
DB_PASS=
DB_SSL=false
